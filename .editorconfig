root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
[*.{cs,csproj,props}]
indent_size = 4
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
[Makefile]
indent_style = tab

[*.cs]
# Deliberate: Result<T>.Success/Failure factories, an `Error` type, and terse DI registrations.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1725.severity = none
dotnet_diagnostic.CA1050.severity = none
dotnet_diagnostic.CA1848.severity = none
# EF queries need ToLowerInvariant()/Contains for case-insensitive SQL; StringComparison overloads do not translate.
dotnet_diagnostic.CA1862.severity = none
# ...and the culture rules do not apply when the expression is translated to SQL (Npgsql translates ToLower(), not ToLowerInvariant()).
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1311.severity = none

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA2211.severity = none
dotnet_diagnostic.CA1861.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
