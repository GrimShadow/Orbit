# One Dockerfile for every .NET host: docker build --build-arg PROJECT=Dam.Api -f deploy/docker/Dockerfile.dotnet .
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG PROJECT
ARG TARGETARCH
SHELL ["/bin/bash", "-c"]
WORKDIR /src
COPY global.json Directory.Build.props .editorconfig Dam.sln ./
COPY src ./src
RUN dotnet publish src/${PROJECT}/${PROJECT}.csproj -c Release -a ${TARGETARCH/amd64/x64} --no-self-contained -o /out \
    -p:UseAppHost=false -p:TreatWarningsAsErrors=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
ARG PROJECT
ENV PROJECT_DLL=${PROJECT}.dll ASPNETCORE_URLS=http://+:8080 DOTNET_EnableDiagnostics=0
# Pull in Debian's security fixes published since the base image was built (e.g. perl-base CVEs fixed in deb12u4 that the
# CI container scan flags as fixable HIGH/CRITICAL). Every host, not just the media ones - the base image carries them all.
RUN apt-get update && apt-get -y --no-install-recommends upgrade && rm -rf /var/lib/apt/lists/*
# Only the worker and the delivery origin touch media: ffmpeg (probe, poster frames, video renditions), poppler-utils
# (pdfinfo, pdftoppm for PDF page renditions), and just the three LibreOffice components that read Word/PowerPoint/Excel
# files (not the full suite: no Draw, Base, Math, or GUI/help/language extras) to convert them to PDF. The other hosts
# stay lean.
RUN if [ "$PROJECT" = "Dam.Worker" ] || [ "$PROJECT" = "Dam.Delivery" ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg poppler-utils libreoffice-writer libreoffice-impress libreoffice-calc \
      && rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /app
COPY --from=build /out .
# Non-root (spec A7.8). Read-only root FS is enforced at run time (compose / Helm), not baked in.
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec dotnet $PROJECT_DLL"]
