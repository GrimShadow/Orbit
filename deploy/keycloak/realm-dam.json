{
  "realm": "dam",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "Admin"
      },
      {
        "name": "Librarian"
      },
      {
        "name": "Editor"
      },
      {
        "name": "Approver"
      },
      {
        "name": "Contributor"
      },
      {
        "name": "Viewer"
      },
      {
        "name": "Dealer"
      },
      {
        "name": "ApiClient"
      }
    ]
