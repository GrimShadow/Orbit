{
  "realm": "dam", "enabled": true, "sslRequired": "none", "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": { "realm": [
    {"name":"Admin"},{"name":"Librarian"},{"name":"Editor"},{"name":"Approver"},
    {"name":"Contributor"},{"name":"Viewer"},{"name":"Dealer"},{"name":"ApiClient"} ] },
  "clientScopes": [ { "name": "dam-claims", "protocol": "openid-connect", "protocolMappers": [
    { "name": "tenant", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": { "claim.name": "tenant", "claim.value": "default", "jsonType.label": "String",
                  "access.token.claim": "true", "id.token.claim": "true" } },
    { "name": "roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
      "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true" } },
    { "name": "audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
      "config": { "included.custom.audience": "dam-api", "access.token.claim": "true" } } ] } ],
  "defaultDefaultClientScopes": ["dam-claims"],
  "clients": [
    { "clientId": "dam-web", "publicClient": true, "standardFlowEnabled": true, "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"], "webOrigins": ["http://localhost:5173"],
      "attributes": {"pkce.code.challenge.method": "S256"}, "defaultClientScopes": ["dam-claims"] },
    { "clientId": "dam-api", "bearerOnly": true },
    { "clientId": "pads4-plugin", "publicClient": false, "serviceAccountsEnabled": true, "standardFlowEnabled": false,
      "secret": "pads4-plugin-dev-secret", "defaultClientScopes": ["dam-claims"] }
  ],
  "users": [
    { "username": "admin@dam.local", "email": "admin@dam.local", "enabled": true, "emailVerified": true,
      "firstName": "Dev", "lastName": "Admin",
      "credentials": [{"type":"password","value":"admin","temporary":false}], "realmRoles": ["Admin"] }
  ]
}
